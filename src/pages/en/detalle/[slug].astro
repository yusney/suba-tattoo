---
import DetallePage from "../../../components/pages/DetallePage.astro";
import { getTattoos } from "../../../lib/tattoos";

export async function getStaticPaths() {
  const all = await getTattoos();
  const slugs = Array.from(new Set(all.map((e) => e.data.slug)));
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
---

<DetallePage locale="en" slug={slug as string} />
