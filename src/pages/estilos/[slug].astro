---
import EstiloPage from "../../components/pages/EstiloPage.astro";
import { getEstilos } from "../../lib/estilos";

export async function getStaticPaths() {
  const estilos = await getEstilos("es");
  return estilos.map((entry) => ({ params: { slug: entry.data.slug } }));
}

const { slug } = Astro.params;
---

<EstiloPage locale="es" slug={slug as string} />
