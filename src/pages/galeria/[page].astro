---
import GalleryPage from "../../components/pages/GalleryPage.astro";
import { getGalleryTattoos, GALLERY_PAGE_SIZE } from "../../lib/gallery";

export async function getStaticPaths({ paginate }) {
  const tattoos = await getGalleryTattoos("es");
  return paginate(tattoos, { pageSize: GALLERY_PAGE_SIZE }).filter(({ params }) => params.page !== "1");
}

const { page } = Astro.props;
---
<GalleryPage locale="es" pageItems={page.data} currentPage={page.currentPage} totalPages={page.lastPage} />
