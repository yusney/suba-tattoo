---
interface Props {
  label: string;
  title: string;
  subtitle?: string;
}

const { label, title, subtitle } = Astro.props;
---

<section class="px-margin-desktop py-section-gap max-w-container-max mx-auto">
  <div class="flex flex-col gap-4 max-w-3xl" data-reveal>
    <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest">
      {label}
    </span>
    <h1 class="font-display-lg text-display-lg uppercase">{title}</h1>
    {subtitle && (
      <p class="font-body-lg text-body-lg text-on-surface-variant mt-4">{subtitle}</p>
    )}
  </div>
</section>
