---
interface Props {
  label: string;
  title: string;
  subtitle?: string;
}

const { label, title, subtitle } = Astro.props;
---

<section class="mx-auto w-full max-w-container-max px-margin-mobile py-12 md:px-margin-desktop md:py-section-gap">
  <div class="flex flex-col gap-4 max-w-3xl" data-reveal>
    <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest">
      {label}
    </span>
    <h1 class="font-display-lg text-4xl mb-6 uppercase leading-[1.05] md:mb-8 md:text-display-lg md:leading-none">{title}</h1>
    {subtitle && (
      <p class="font-body-lg text-body-lg text-on-surface-variant mt-4">{subtitle}</p>
    )}
  </div>
</section>
