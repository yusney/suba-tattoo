---
interface Props { label?: string; title: string; subtitle?: string; }
const { label, title, subtitle } = Astro.props;
---
<div class="mb-16" data-reveal>
  {label && <span class="mb-3 block text-label-sm font-label-sm uppercase tracking-widest text-primary">{label}</span>}
  <h2 class="mb-6 text-3xl font-headline-lg uppercase md:mb-8 md:text-headline-lg">{title}</h2>
  {subtitle && <p class="text-body-lg font-body-lg text-on-surface-variant">{subtitle}</p>}
  <slot />
</div>