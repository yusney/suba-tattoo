---
import { useTranslations, DEFAULT_LOCALE } from "../lib/i18n";
import type { Locale } from "../lib/i18n";

interface Tattoo {
  slug: string;
  title: string;
  style: string;
  year: number;
  image: string;
  alt_text: string;
  href: string;
}

interface Props {
  items: Tattoo[];
  archiveHref: string;
}

const rawLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const locale: Locale = (["es", "en", "ca"] as Locale[]).includes(rawLocale) ? rawLocale : DEFAULT_LOCALE;
const t = useTranslations(locale);

const { items, archiveHref } = Astro.props;
---

<section class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop mb-section-gap">
  <div class="flex justify-between items-end mb-12">
    <h2 class="font-headline-lg text-3xl mb-6 uppercase md:mb-8 md:text-headline-lg">{t("detalle.related_title")}</h2>
    <a class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-colors border-b border-outline-variant pb-1 uppercase" href={archiveHref}>
      {t("detalle.view_all")}
    </a>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
    {items.map((it) => (
      <a class="group block" href={it.href}>
        <div class="border border-outline-variant mb-4 overflow-hidden aspect-[3/4]">
          <img
            class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-[filter] duration-700"
            src={it.image}
            alt={it.alt_text}
            loading="lazy"
            decoding="async"
            width="800"
            height="1066"
          />
        </div>
        <p class="font-label-sm text-[10px] text-on-surface-variant mb-1 uppercase">
          {it.style} · {it.year}
        </p>
        <h3 class="font-headline-md text-2xl uppercase group-hover:text-primary transition-colors">
          {it.title}
        </h3>
      </a>
    ))}
  </div>
</section>
