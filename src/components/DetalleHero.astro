---
interface Props {
  image: string;
  alt: string;
}

const { image, alt } = Astro.props;
---

<section class="w-full">
  <div class="mx-auto w-full max-w-container-max px-margin-mobile py-8 md:px-margin-desktop">
    <div class="aspect-[16/9] w-full border border-outline-variant overflow-hidden relative">
      <img class="w-full h-full object-cover" src={image} alt={alt} width="1280" height="720" />
    </div>
  </div>
</section>
