---
import { useTranslations, DEFAULT_LOCALE } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
import { getSiteSettings } from "../lib/site";

const rawLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const locale: Locale = (["es", "en", "ca"] as Locale[]).includes(rawLocale) ? rawLocale : DEFAULT_LOCALE;
const t = useTranslations(locale);

const styleOptions = t.array("reserva.form.style_options");

const statusStrings = {
  sending: t("booking_form.sending"),
  success: t("booking_form.success"),
  error_network: t("booking_form.error_network"),
  error_server: t("booking_form.error_server"),
};

const errorStrings = {
  required: t("form_errors.required"),
  email_format: t("form_errors.email_format"),
  phone_format: t("form_errors.phone_format"),
  too_long: t("form_errors.too_long"),
  invalid: t("form_errors.invalid"),
  privacy_required: t("form_gdpr.privacy_required_error"),
};

// GDPR/LOPDGDD compact first-layer + privacy consent. Read tax_id and
// policy_version from site_settings so the consent record travels with
// each submission. The detailed fields (address, recipients, retention,
// etc.) live in /privacidad — the form only carries the three minimum
// pieces required by Art. 11.1 LOPDGDD inline: controller, purpose +
// legal basis, link to the full policy.
const settings = await getSiteSettings(locale);
const taxId = settings.tax_id ?? "[NIF/CIF pendiente]";
const policyVersion = settings.policy_version ?? "v1.0";
const privacyLink = locale === DEFAULT_LOCALE ? "/privacidad" : `/${locale}/privacidad`;

const gdprStrings = {
  info_compact: t("form_gdpr.info_compact", { tax_id: taxId }),
  privacy_aria: t("form_gdpr.privacy_aria"),
  privacy_label: t("form_gdpr.privacy_label"),
  privacy_link_text: t("form_gdpr.privacy_link_text"),
  privacy_required_error: t("form_gdpr.privacy_required_error"),
  privacy_link_href: privacyLink,
};
---

<section class="mx-auto w-full max-w-6xl px-margin-mobile md:px-margin-desktop">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
    <div class="lg:col-span-8">
      <h2 class="font-headline-md text-headline-md uppercase mb-12 flex items-center gap-4" data-reveal>
        <span class="w-12 h-px bg-primary"></span>
        {t("reserva.form.title")}
      </h2>
      <form data-booking-form data-strings={JSON.stringify(statusStrings)} data-errors={JSON.stringify(errorStrings)} data-gdpr={JSON.stringify(gdprStrings)} novalidate class="space-y-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
          <div class="group">
            <label for="nombre" class="font-label-sm text-[10px] uppercase text-on-surface-variant group-focus-within:text-primary transition-colors block mb-2">{t("reserva.form.label_name")}</label>
            <input id="nombre" name="nombre" type="text" autocomplete="name" required aria-describedby="nombre-error" placeholder={t("reserva.form.placeholder_name") as string} class="w-full bg-transparent border-0 border-b border-outline-variant py-3 font-body-md text-on-surface focus:outline-none focus:border-primary transition-colors touch-manipulation" />
            <p id="nombre-error" data-field-error="nombre" class="hidden font-label-sm text-[10px] uppercase text-error mt-2" role="alert"></p>
          </div>
          <div class="group">
            <label for="email" class="font-label-sm text-[10px] uppercase text-on-surface-variant group-focus-within:text-primary transition-colors block mb-2">{t("reserva.form.label_email")}</label>
            <input id="email" name="email" type="email" autocomplete="email" inputmode="email" spellcheck="false" required aria-describedby="email-error" placeholder={t("reserva.form.placeholder_email") as string} class="w-full bg-transparent border-0 border-b border-outline-variant py-3 font-body-md text-on-surface focus:outline-none focus:border-primary transition-colors touch-manipulation" />
            <p id="email-error" data-field-error="email" class="hidden font-label-sm text-[10px] uppercase text-error mt-2" role="alert"></p>
          </div>
          <div class="group">
            <label for="telefono" class="font-label-sm text-[10px] uppercase text-on-surface-variant group-focus-within:text-primary transition-colors block mb-2">{t("reserva.form.label_phone")}</label>
            <input id="telefono" name="telefono" type="tel" autocomplete="tel" inputmode="tel" required aria-describedby="telefono-error" placeholder={t("reserva.form.placeholder_phone") as string} class="w-full bg-transparent border-0 border-b border-outline-variant py-3 font-body-md text-on-surface focus:outline-none focus:border-primary transition-colors touch-manipulation" />
            <p id="telefono-error" data-field-error="telefono" class="hidden font-label-sm text-[10px] uppercase text-error mt-2" role="alert"></p>
          </div>
          <div class="group">
            <label for="estilo" class="font-label-sm text-[10px] uppercase text-on-surface-variant group-focus-within:text-primary transition-colors block mb-2">{t("reserva.form.label_style")}</label>
            <select id="estilo" name="estilo" autocomplete="off" aria-describedby="estilo-error" class="w-full bg-surface border-0 border-b border-outline-variant py-3 font-body-md text-on-surface focus:outline-none focus:border-primary transition-colors appearance-none touch-manipulation">
              {(Array.isArray(styleOptions) ? styleOptions : []).map((opt: string) => (
                <option value={opt}>{opt}</option>
              ))}
            </select>
            <p id="estilo-error" data-field-error="estilo" class="hidden font-label-sm text-[10px] uppercase text-error mt-2" role="alert"></p>
          </div>
          <div class="group">
            <label for="zona" class="font-label-sm text-[10px] uppercase text-on-surface-variant group-focus-within:text-primary transition-colors block mb-2">{t("reserva.form.label_zone")}</label>
            <input id="zona" name="zona" type="text" autocomplete="off" aria-describedby="zona-error" placeholder={t("reserva.form.placeholder_zone") as string} class="w-full bg-transparent border-0 border-b border-outline-variant py-3 font-body-md text-on-surface focus:outline-none focus:border-primary transition-colors touch-manipulation" />
            <p id="zona-error" data-field-error="zona" class="hidden font-label-sm text-[10px] uppercase text-error mt-2" role="alert"></p>
          </div>
          <div class="group">
            <label for="tamano" class="font-label-sm text-[10px] uppercase text-on-surface-variant group-focus-within:text-primary transition-colors block mb-2">{t("reserva.form.label_size")}</label>
            <input id="tamano" name="tamano" type="text" autocomplete="off" aria-describedby="tamano-error" placeholder={t("reserva.form.placeholder_size") as string} class="w-full bg-transparent border-0 border-b border-outline-variant py-3 font-body-md text-on-surface focus:outline-none focus:border-primary transition-colors touch-manipulation" />
            <p id="tamano-error" data-field-error="tamano" class="hidden font-label-sm text-[10px] uppercase text-error mt-2" role="alert"></p>
          </div>
          <div class="group md:col-span-2">
            <label for="fecha" class="font-label-sm text-[10px] uppercase text-on-surface-variant group-focus-within:text-primary transition-colors block mb-2">{t("reserva.form.label_date")}</label>
            <input id="fecha" name="fecha" type="date" autocomplete="off" aria-describedby="fecha-error" class="w-full bg-transparent border-0 border-b border-outline-variant py-3 font-body-md text-on-surface focus:outline-none focus:border-primary transition-colors touch-manipulation" />
            <p id="fecha-error" data-field-error="fecha" class="hidden font-label-sm text-[10px] uppercase text-error mt-2" role="alert"></p>
          </div>
        </div>
        <div class="group">
          <label for="descripcion" class="font-label-sm text-[10px] uppercase text-on-surface-variant group-focus-within:text-primary transition-colors block mb-2">{t("reserva.form.label_description")}</label>
          <textarea id="descripcion" name="descripcion" rows="4" autocomplete="off" aria-describedby="descripcion-error" placeholder={t("reserva.form.placeholder_description") as string} class="w-full bg-transparent border-0 border-b border-outline-variant py-3 font-body-md text-on-surface resize-none focus:outline-none focus:border-primary transition-colors touch-manipulation"></textarea>
          <p id="descripcion-error" data-field-error="descripcion" class="hidden font-label-sm text-[10px] uppercase text-error mt-2" role="alert"></p>
        </div>
        <!-- Honeypot: hidden off-screen field that bots auto-fill and humans never see. -->
        <input type="text" name="sitio_web" id="sitio_web-honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[9999px] top-0 h-px w-px opacity-0 pointer-events-none" />

        <!-- Cloudflare Turnstile: server verifies the token in handleContact.
             The widget resolves automatically in the background (managed
             mode); the token lands in the hidden input below via the callback. -->
        <input type="hidden" name="cf-turnstile-response" id="cf-turnstile-response-booking" />
        <div class="pt-2">
          <div
            class="cf-turnstile"
            data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}
            data-callback="onBookingTurnstileSuccess"
          ></div>
        </div>

        <!-- GDPR/LOPDGDD compact first-layer + privacy consent. Art. 13 RGPD
             and Art. 11 LOPDGDD require an explicit consent BEFORE any
             personal data is sent. Inline we carry the three minimum
             pieces (controller + purpose/legal basis + link to the full
             policy). The full detail (address, recipients, retention,
             rights, security measures) lives in /privacidad. -->
        <input type="hidden" name="policy_version" value={policyVersion} />
        <p class="mt-4 text-xs text-on-surface-variant leading-relaxed" style="white-space: pre-line;">
          <Fragment set:html={gdprStrings.info_compact
            .replace("{privacy_link}", `<a href="${privacyLink}" class="text-primary underline-offset-4 hover:underline">${gdprStrings.privacy_link_text}</a>`)} />
        </p>
        <label class="flex items-start gap-3 mt-4 text-sm text-on-surface-variant">
          <input
            type="checkbox"
            name="privacy_accepted"
            id="privacy-accepted-booking"
            value="true"
            required
            aria-required="true"
            aria-describedby="privacy-error-booking"
            aria-invalid="false"
            class="mt-1 h-5 w-5 shrink-0 cursor-pointer accent-primary"
          />
          <span class="font-label-sm text-label-sm text-on-surface leading-snug">
            <Fragment set:html={gdprStrings.privacy_label
              .replace("{privacy_link}", `<a href="${privacyLink}" class="text-primary underline-offset-4 hover:underline">${gdprStrings.privacy_link_text}</a>`)} />
          </span>
        </label>
        <p id="privacy-error-booking" data-privacy-error class="hidden font-label-sm text-[10px] uppercase text-error mt-1" role="alert"></p>

        <div class="flex flex-col items-center gap-4 pt-8">
          <button data-booking-submit class="bg-primary text-on-primary w-full md:w-auto px-16 py-5 font-headline-md text-2xl uppercase tracking-tighter flex items-center justify-center gap-4 hover:bg-primary-fixed hover:text-surface transition-[background-color,color] duration-300 touch-manipulation disabled:cursor-not-allowed disabled:opacity-50" type="submit">
            <span data-submit-label>{t("reserva.form.submit")}</span>
            <span class="material-symbols-outlined text-4xl" aria-hidden="true">arrow_right_alt</span>
          </button>
          <p class="font-label-sm text-[10px] uppercase opacity-40 text-center">{t("reserva.form.legal")}</p>
        </div>
      </form>
    </div>
    <div class="lg:col-span-4">
      <slot name="aside" />
    </div>
  </div>
</section>

<script>
  import { validateBooking, type FieldError } from "../lib/forms";
  import { showToast } from "../lib/toast";

  declare global {
    interface Window {
      turnstile?: {
        render: (container: string | HTMLElement, options?: object) => string;
        reset: (widgetId?: string) => void;
        remove: (widgetId?: string) => void;
      };
      onBookingTurnstileSuccess?: (token: string) => void;
    }
  }

  // Turnstile widget callback: stores the resolved token in the hidden
  // input so it travels with the FormData on submit. The widget script
  // (loaded in Layout.astro) finds `window.onBookingTurnstileSuccess`
  // by name from the `data-callback` attribute on the widget div.
  window.onBookingTurnstileSuccess = (token: string) => {
    const input = document.getElementById("cf-turnstile-response-booking") as HTMLInputElement | null;
    if (input) input.value = token;
  };

  type BookingStatus = "idle" | "sending" | "success" | "error";
  type StatusStrings = {
    sending: string;
    success: string;
    error_network: string;
    error_server: string;
  };
  type ErrorStrings = {
    required: string;
    email_format: string;
    phone_format: string;
    too_long: string;
    invalid: string;
  };
  type GdprStrings = {
    privacy_required_error: string;
    privacy_link_href: string;
  };

  const form = document.querySelector<HTMLFormElement>("[data-booking-form]");
  const submit = document.querySelector<HTMLButtonElement>("[data-booking-submit]");
  if (form && submit) {
    let strings: StatusStrings;
    try {
      strings = JSON.parse(form.dataset.strings ?? "{}") as StatusStrings;
    } catch {
      strings = { sending: "Enviando...", success: "Mensaje enviado.", error_network: "No se pudo enviar.", error_server: "El servidor no está disponible." };
    }

    let errorStrings: ErrorStrings;
    try {
      errorStrings = JSON.parse(form.dataset.errors ?? "{}") as ErrorStrings;
    } catch {
      errorStrings = { required: "Este campo es obligatorio.", email_format: "Email inválido.", phone_format: "Teléfono inválido.", too_long: "Máximo {max} caracteres.", invalid: "Revisá este campo." };
    }

    let gdprStrings: GdprStrings;
    try {
      gdprStrings = JSON.parse(form.dataset.gdpr ?? "{}") as GdprStrings;
    } catch {
      gdprStrings = { privacy_required_error: "Debes aceptar la Política de Privacidad para continuar.", privacy_link_href: "/privacidad" };
    }

    const labelEl = submit.querySelector<HTMLElement>("[data-submit-label]");
    const defaultLabel = labelEl?.textContent ?? submit.textContent ?? "";

    const watchedFields = [
      "nombre",
      "email",
      "telefono",
      "estilo",
      "zona",
      "tamano",
      "fecha",
      "descripcion",
    ];

    const getFieldNodes = (field: string): { input: HTMLElement; error: HTMLElement | null } | null => {
      const input = form.querySelector<HTMLElement>(`[name="${CSS.escape(field)}"]`);
      if (!input) return null;
      const error = form.querySelector<HTMLElement>(`[data-field-error="${CSS.escape(field)}"]`);
      return { input, error };
    };

    const setFieldError = (field: string, message: string): void => {
      const nodes = getFieldNodes(field);
      if (!nodes) return;
      nodes.input.setAttribute("aria-invalid", "true");
      nodes.input.classList.remove("border-outline-variant");
      nodes.input.classList.add("border-error");
      if (nodes.error) {
        nodes.error.textContent = message;
        nodes.error.classList.remove("hidden");
      }
    };

    const clearFieldError = (field: string): void => {
      const nodes = getFieldNodes(field);
      if (!nodes) return;
      nodes.input.removeAttribute("aria-invalid");
      nodes.input.classList.remove("border-error");
      nodes.input.classList.add("border-outline-variant");
      if (nodes.error) {
        nodes.error.textContent = "";
        nodes.error.classList.add("hidden");
      }
    };

    const clearAllFieldErrors = (): void => {
      form.querySelectorAll<HTMLElement>("[data-field-error]").forEach((el) => {
        const field = el.getAttribute("data-field-error");
        if (field) clearFieldError(field);
      });
    };

    const reasonToMessage = (field: string, reason: string, max?: number): string => {
      if (reason === "too_long" && typeof max === "number") {
        return errorStrings.too_long.replace("{max}", String(max));
      }
      if (reason === "missing" || reason === "invalid_type") return errorStrings.required;
      if (reason === "invalid_format") {
        if (field === "email") return errorStrings.email_format;
        if (field === "telefono") return errorStrings.phone_format;
      }
      return errorStrings.invalid;
    };

    const focusField = (field: string): void => {
      const nodes = getFieldNodes(field);
      if (!nodes) return;
      const focusable = nodes.input as HTMLElement & { focus?: () => void };
      if (typeof focusable.focus === "function") focusable.focus();
    };

    let state: BookingStatus = "idle";

    watchedFields.forEach((field) => {
      const input = form.querySelector<HTMLElement>(`[name="${field}"]`);
      if (!input) return;
      const handler = () => {
        if (input.getAttribute("aria-invalid") === "true") clearFieldError(field);
      };
      input.addEventListener("input", handler);
      input.addEventListener("change", handler);
    });

    // GDPR/LOPDGDD: client-side gate for the privacy checkbox. Server is
    // authoritative (handleContact rejects 400 if privacy_accepted !== true)
    // but we block the submit here for UX so the user sees an inline field
    // error instead of a server round-trip.
    const privacyCheckbox = form.querySelector<HTMLInputElement>("input[name=\"privacy_accepted\"]");
    const privacyErrorEl = form.querySelector<HTMLElement>("[data-privacy-error]");
    const setPrivacyError = (msg: string): void => {
      if (!privacyCheckbox || !privacyErrorEl) return;
      privacyCheckbox.setAttribute("aria-invalid", "true");
      privacyErrorEl.textContent = msg;
      privacyErrorEl.classList.remove("hidden");
    };
    const clearPrivacyError = (): void => {
      if (!privacyCheckbox || !privacyErrorEl) return;
      privacyCheckbox.removeAttribute("aria-invalid");
      privacyErrorEl.textContent = "";
      privacyErrorEl.classList.add("hidden");
    };
    privacyCheckbox?.addEventListener("change", () => {
      if (privacyCheckbox.checked) clearPrivacyError();
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (state === "sending") return;

      // Privacy gate (Art. 13 RGPD + Art. 11 LOPDGDD)
      if (privacyCheckbox && !privacyCheckbox.checked) {
        setPrivacyError(gdprStrings.privacy_required_error);
        privacyCheckbox.focus();
        return;
      }
      clearPrivacyError();

      const formData = new FormData(form);
      const payload = {
        form: "booking" as const,
        nombre: String(formData.get("nombre") ?? ""),
        email: String(formData.get("email") ?? ""),
        telefono: String(formData.get("telefono") ?? ""),
        estilo: String(formData.get("estilo") ?? ""),
        zona: String(formData.get("zona") ?? ""),
        tamano: String(formData.get("tamano") ?? ""),
        fecha: String(formData.get("fecha") ?? ""),
        descripcion: String(formData.get("descripcion") ?? ""),
        sitio_web: String(formData.get("sitio_web") ?? ""),
        "cf-turnstile-response": String(formData.get("cf-turnstile-response") ?? ""),
        privacy_accepted: privacyCheckbox?.checked ?? false,
        policy_version: String(formData.get("policy_version") ?? ""),
      };

      const clientErrors = validateBooking(payload);
      if (clientErrors.length > 0) {
        clearAllFieldErrors();
        for (const err of clientErrors) {
          setFieldError(err.field, reasonToMessage(err.field, err.reason, err.max));
        }
        focusField(clientErrors[0]!.field);
        return;
      }

      clearAllFieldErrors();
      submit.disabled = true;
      if (labelEl) labelEl.textContent = strings.sending;
      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          form.reset();
          clearAllFieldErrors();
          clearPrivacyError();
          showToast(strings.success, "success");
          // Turnstile tokens are single-use — regenerate so a second submit
          // (e.g., user wants to send another message) gets a fresh token.
          if (typeof window !== "undefined" && window.turnstile) {
            window.turnstile.reset();
          }
        } else if (res.status === 400) {
          const data: unknown = await res.json().catch(() => ({}));
          const details = (() => {
            if (data && typeof data === "object" && "details" in data) {
              const d = (data as { details?: unknown }).details;
              return Array.isArray(d) ? (d as FieldError[]) : [];
            }
            return [];
          })();
          if (details.length > 0) {
            clearAllFieldErrors();
            for (const err of details) {
              if (typeof err.field === "string" && typeof err.reason === "string") {
                setFieldError(err.field, reasonToMessage(err.field, err.reason, err.max));
              }
            }
            const first = details.find((d) => typeof d.field === "string");
            if (first) focusField(first.field);
          } else {
            // Server returned 400 with no field-level details — likely a
            // privacy_required / captcha_required / captcha_misconfigured.
            // Surface the privacy error if the server complained about
            // privacy; otherwise show the generic toast.
            const errorCode = (data && typeof data === "object" && "error" in data)
              ? String((data as { error?: unknown }).error)
              : "";
            if (errorCode === "privacy_required") {
              setPrivacyError(gdprStrings.privacy_required_error);
              if (privacyCheckbox) privacyCheckbox.focus();
            } else {
              showToast(errorStrings.invalid, "error");
            }
          }
        } else {
          showToast(strings.error_server, "error");
        }
      } catch {
        showToast(strings.error_network, "error");
      } finally {
        submit.disabled = false;
        if (labelEl) labelEl.textContent = defaultLabel;
        else submit.textContent = defaultLabel;
      }
    });
  }
</script>
