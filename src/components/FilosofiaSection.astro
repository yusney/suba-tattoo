---
import { useTranslations, DEFAULT_LOCALE } from "../lib/i18n";
import type { Locale } from "../lib/i18n";

const rawLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const locale: Locale = (["es", "en", "ca"] as Locale[]).includes(rawLocale) ? rawLocale : DEFAULT_LOCALE;
const t = useTranslations(locale);

const cards = [
  { icon: "architecture", titleKey: "filosofia.card1_title", bodyKey: "filosofia.card1_body" },
  { icon: "sanitizer", titleKey: "filosofia.card2_title", bodyKey: "filosofia.card2_body" },
  { icon: "forum", titleKey: "filosofia.card3_title", bodyKey: "filosofia.card3_body" },
];
---

<section class="relative mx-auto w-full max-w-container-max px-margin-mobile py-12 md:px-margin-desktop md:py-section-gap" id="about">
  <span class="section-marker" aria-hidden="true">01 / 03</span>
  <div class="grid items-start gap-gutter lg:grid-cols-12" data-reveal>
    <div class="self-start lg:sticky lg:top-24 lg:col-span-5">
      <h2 class="mb-6 text-3xl font-headline-lg uppercase md:mb-8 md:text-headline-lg">{t("filosofia.title")}</h2>
      <p class="mb-12 text-body-lg font-body-lg text-on-surface-variant text-justify leading-relaxed md:text-left">{t("filosofia.body")}</p>
    </div>
    <div class="grid gap-6 md:grid-cols-3 lg:col-span-7">
      {cards.map((card, i) => (
        <article
          class="border border-outline-variant bg-surface-container-low p-8 transition-colors hover:border-primary"
          data-reveal-card
          style={`transition-delay: ${i * 150}ms`}
        >
          <span class="material-symbols-outlined mb-6 text-4xl text-primary">{card.icon}</span>
          <h3 class="mb-4 text-label-sm font-label-sm font-bold uppercase">{t(card.titleKey)}</h3>
          <p class="text-body-md font-body-md text-on-surface-variant text-justify leading-relaxed md:text-left">{t(card.bodyKey)}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("is-revealed");
        revealObserver.unobserve(entry.target);
      }
    });
  }, { rootMargin: "0px 0px -15% 0px" });

  document.querySelectorAll("[data-reveal-card]").forEach((el) => revealObserver.observe(el));
</script>