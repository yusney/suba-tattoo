---
import { useTranslations, DEFAULT_LOCALE } from "../lib/i18n";
import type { Locale } from "../lib/i18n";

const rawLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const locale: Locale = (["es", "en", "ca"] as Locale[]).includes(rawLocale) ? rawLocale : DEFAULT_LOCALE;
const t = useTranslations(locale);
---

<div class="sticky top-32 p-8 border border-primary/30 bg-surface-container-low">
  <h4 class="font-label-sm text-label-sm text-primary uppercase mb-6 flex items-center gap-2">
    <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;" aria-hidden="true">gavel</span>
    {t("reserva.policy_title")}
  </h4>
  <ul class="space-y-6 text-sm text-on-surface-variant">
    {t.array("reserva.policy_bullets").map((b: any) => (
      <li class="flex gap-4">
        <span class="font-label-sm text-primary">{b.number}</span>
        <p class="text-justify leading-relaxed md:text-left">
          <strong class="text-on-surface uppercase block text-[10px] mb-1">{b.title}</strong>
          {b.body}
        </p>
      </li>
    ))}
  </ul>
  <div class="mt-8 pt-8 border-t border-outline-variant">
    <div class="aspect-square bg-surface-container-high relative flex items-center justify-center overflow-hidden">
      <img
        class="absolute inset-0 w-full h-full object-cover mix-blend-luminosity opacity-40"
        alt={t("reserva.image_alt") as string}
        src="/images/reserva/policy-decorative.jpg"
        width="512"
        height="512"
      />
      <span class="relative z-10 font-label-sm text-[10px] uppercase tracking-[0.3em] rotate-90">{t("reserva.studio_identity")}</span>
    </div>
  </div>
</div>
