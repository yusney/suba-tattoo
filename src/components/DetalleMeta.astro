---
interface Props {
  pieceNumber: string;
  style: string;
  year: number;
}

const { pieceNumber, style, year } = Astro.props;
const meta = `${pieceNumber} · ${style.toUpperCase()} · ${year}`;
---

<div class="w-full border-b border-outline-variant bg-surface">
  <div class="mx-auto flex w-full max-w-container-max flex-col items-center justify-between gap-4 px-margin-mobile py-4 md:flex-row md:px-margin-desktop">
    <div class="font-label-sm text-label-sm text-on-surface-variant tracking-widest uppercase">
      {meta}
    </div>
  </div>
</div>
