---
import { getCollection } from "astro:content";
import { useTranslations, DEFAULT_LOCALE } from "../lib/i18n";
import type { Locale } from "../lib/i18n";

const rawLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const locale: Locale = (["es", "en", "ca"] as Locale[]).includes(rawLocale) ? rawLocale : DEFAULT_LOCALE;
const t = useTranslations(locale);

const allTattoos = await getCollection("tattoos");
const tattoos = allTattoos
  .filter((entry) => entry.data.locale === locale)
  .sort((a, b) => +b.data.date - +a.data.date);

const allCategories = Array.from(new Set(tattoos.map((t) => t.data.category)));
const filters = [t("gallery.filter_all"), ...allCategories];

const featured = tattoos.find((t) => t.data.featured);
const rest = tattoos.filter((t) => !t.data.featured);
const ordered = featured ? [featured, ...rest] : tattoos;

const detailHref = (slug: string) =>
  locale === DEFAULT_LOCALE ? `/detalle/${slug}` : `/${locale}/detalle/${slug}`;
---

<section class="mx-auto max-w-container-max bg-surface-container-lowest px-margin-desktop py-section-gap relative" id="gallery">
  <span class="section-marker" aria-hidden="true">02 / 03</span>
  <div class="flex flex-col items-end justify-between gap-8 md:flex-row" data-reveal>
    <div>
      <h2 class="mb-2 text-headline-lg font-headline-lg uppercase">{t("gallery.title")}</h2>
      <p class="text-label-sm font-label-sm uppercase tracking-widest text-on-surface-variant">{t("gallery.subtitle")}</p>
    </div>
    <div class="flex flex-wrap gap-4 border-b border-outline-variant pb-2">
      {filters.map((filter, index) => (
        <button
          class={`px-4 py-2 text-label-sm font-label-sm uppercase tracking-widest ${index === 0 ? "border-b-2 border-primary text-primary" : "text-on-surface-variant hover:text-on-surface"}`}
        >
          {filter}
        </button>
      ))}
    </div>
  </div>
  <div class="mt-16 grid grid-cols-1 gap-8 md:grid-cols-3" data-reveal>
    {ordered.map((tattoo, idx) => {
      const isFeature = tattoo.data.featured;
      const wrapperClass = `group gallery-card relative aspect-square overflow-hidden border border-outline-variant bg-surface-container-high ${isFeature ? "md:col-span-2 md:aspect-[16/10]" : ""}`;
      return (
        <a class={wrapperClass} data-idx={idx} href={detailHref(tattoo.data.slug)}>
          <img
            class="h-full w-full object-cover grayscale transition-[filter,transform] duration-700 group-hover:scale-105 group-hover:grayscale-0"
            src={tattoo.data.image}
            alt={tattoo.data.alt_text}
            loading={isFeature ? "eager" : "lazy"}
            decoding="async"
            width={isFeature ? 1280 : 800}
            height={isFeature ? 800 : 800}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-surface to-transparent opacity-60"></div>
          <div class="absolute bottom-6 left-6">
            <span class="mb-1 block text-label-sm font-label-sm uppercase tracking-widest text-primary">{tattoo.data.category}</span>
            {tattoo.data.title && (
              <h3 class="text-headline-md font-headline-md uppercase">{tattoo.data.title}</h3>
            )}
          </div>
        </a>
      );
    })}
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const target = entry.target as HTMLElement;
        const idx = Number(target.dataset.idx ?? "0");
        target.style.transitionDelay = `${idx * 150}ms`;
        target.classList.add("is-revealed");
        observer.unobserve(target);
      });
    },
    { rootMargin: "0px 0px -10% 0px" }
  );

  document.querySelectorAll<HTMLElement>(".gallery-card").forEach((el) => observer.observe(el));
</script>
