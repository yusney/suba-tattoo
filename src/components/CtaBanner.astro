---
interface Props {
  title: string;
  buttonLabel: string;
  buttonHref: string;
}

const { title, buttonLabel, buttonHref } = Astro.props;
---

<section class="relative w-full py-section-gap border-t border-b border-outline-variant overflow-hidden">
  <div class="absolute inset-0 technical-grid opacity-30 pointer-events-none"></div>
  <div class="px-margin-desktop max-w-container-max mx-auto text-center relative z-10">
    <h2 class="font-display-lg text-4xl mb-6 uppercase leading-[1.05] md:mb-8 md:text-display-lg md:leading-none" data-reveal>{title}</h2>
    <a
      href={buttonHref}
      class="inline-block w-full md:w-auto bg-primary text-on-primary px-16 py-8 font-label-sm text-label-sm uppercase tracking-[0.2em] hover:bg-primary-fixed hover:text-surface transition-[background-color,color,transform] active:scale-95 text-xl font-bold touch-manipulation"
      data-reveal
    >
      {buttonLabel}
    </a>
  </div>
</section>
