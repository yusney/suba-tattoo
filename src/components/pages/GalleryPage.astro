---
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import ScrollReveal from "../../components/ScrollReveal.astro";
import GalleryFilter from "../../components/GalleryFilter.astro";
import { getCollection } from "astro:content";
import { useTranslations, DEFAULT_LOCALE } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const t = useTranslations(locale);

const PAGE_SIZE = 18;

const allTattoos = await getCollection("tattoos");
const tattoos = allTattoos
  .filter((entry) => entry.data.locale === locale)
  .sort((a, b) => +b.data.date - +a.data.date);

const styles = Array.from(new Set(tattoos.map((entry) => entry.data.style)));
const totalCount = tattoos.length;
const detailHref = (slug: string) =>
  locale === DEFAULT_LOCALE ? `/detalle/${slug}` : `/${locale}/detalle/${slug}`;
const homeHref = locale === DEFAULT_LOCALE ? "/" : `/${locale}/`;
---

<Layout title={t("gallery_page.title")} description={t("gallery_page.subtitle")}>
  <style is:global>
    /*
     * GalleryPage cards must be visible without the global clip-path reveal
     * animation. The home GallerySection owns that animation, but here the
     * cards can sit far below the fold and IntersectionObserver won't trigger
     * because the layout box reports the clipped (zero-area) state. Showing
     * them outright avoids the bug.
     */
    .gallery-card,
    .gallery-card.is-revealed {
      clip-path: none !important;
    }
  </style>
  <TopBar />
  <main id="main" class="pt-24 scroll-mt-24">
    <section class="relative mx-auto w-full max-w-container-max bg-surface-container-lowest px-margin-mobile py-12 md:px-margin-desktop md:py-section-gap" id="galeria">
      <span class="section-marker" aria-hidden="true">02 / 03</span>
      <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-end" data-reveal>
        <div>
          <h1 class="mb-6 text-3xl font-headline-lg uppercase md:mb-8 md:text-headline-lg">{t("gallery_page.title")}</h1>
          <p class="text-label-sm font-label-sm uppercase tracking-widest text-on-surface-variant">{t("gallery_page.subtitle")}</p>
        </div>
        <a class="text-label-sm font-label-sm uppercase tracking-widest text-on-surface-variant hover:text-primary border-b border-outline-variant pb-1" href={homeHref}>
          ← {t("gallery_page.back_home")}
        </a>
      </div>

      <GalleryFilter styles={styles} allLabel={t("gallery.filter_all")} filterLabel={t("gallery_page.filter_label")} />

      <p
        class="mt-12 text-label-sm font-label-sm uppercase tracking-widest text-on-surface-variant"
        data-gallery-count
        data-count-one={t("gallery_page.count_one")}
        data-count-other={t("gallery_page.count_other")}
      >
        {totalCount === 1 ? t("gallery_page.count_one").replace("{{count}}", String(totalCount)) : t("gallery_page.count_other").replace("{{count}}", String(totalCount))}
      </p>

      <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-3" data-reveal>
        {tattoos.map((tattoo) => {
          const slug = tattoo.data.slug;
          return (
            <a
              class="group gallery-card relative aspect-square overflow-hidden border border-outline-variant bg-surface-container-high"
              href={detailHref(slug)}
              data-style={tattoo.data.style}
              data-detail-href={detailHref(slug)}
            >
              <img
                class="h-full w-full object-cover grayscale transition-[filter,transform] duration-700 group-hover:scale-105 group-hover:grayscale-0"
                src={tattoo.data.image}
                alt={tattoo.data.alt_text}
                loading="lazy"
                decoding="async"
                width="800"
                height="800"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-surface to-transparent opacity-60"></div>
              <div class="absolute bottom-6 left-6">
                <span class="mb-1 block text-label-sm font-label-sm uppercase tracking-widest text-primary">{tattoo.data.style}</span>
                {tattoo.data.title && (
                  <h2 class="text-headline-md font-headline-md uppercase">{tattoo.data.title}</h2>
                )}
              </div>
            </a>
          );
        })}
      </div>

      <div class="mt-12 flex justify-center" data-sentinel aria-hidden="true">
        <span class="text-label-sm font-label-sm uppercase tracking-widest text-on-surface-variant opacity-0" data-end-message>
          {t("gallery_page.end_message")}
        </span>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppButton />
  <ScrollReveal />
</Layout>

<script>
  // Clear the global .gallery-card clip-path animation as soon as each card
  // enters the viewport. GalleryPage cards are not picked up by the home
  // GallerySection's observer, so without this they stay clipped at
  // clip-path: inset(0 100% 0 0) (see styles/global.css).
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-revealed");
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );
  document.querySelectorAll(".gallery-card").forEach((el) => revealObserver.observe(el));
</script>

<script define:vars={{ PAGE_SIZE }}>
  const pageSize = PAGE_SIZE;
  const cards = Array.from(document.querySelectorAll(".gallery-card"));
  const countEl = document.querySelector("[data-gallery-count]");
  const sentinel = document.querySelector("[data-sentinel]");
  const endMessage = document.querySelector("[data-end-message]");
  const filterButtons = Array.from(document.querySelectorAll("[data-filter-style]"));

  let extraShown = 0;
  let loading = false;

  function applyVisibility() {
    let shown = 0;
    cards.forEach((card) => {
      card.style.display = "";
      if (card.hidden) return;
      shown += 1;
      const offsetIndex = shown - 1;
      if (offsetIndex >= pageSize + extraShown) {
        card.style.display = "none";
      }
    });
    return shown;
  }

  function setActiveButton(style) {
    filterButtons.forEach((b) => {
      b.classList.remove("border-b-2", "border-primary", "text-primary");
      b.classList.add("text-on-surface-variant");
    });
    const target = filterButtons.find((b) => b.dataset.filterStyle === style);
    if (target) {
      target.classList.add("border-b-2", "border-primary", "text-primary");
      target.classList.remove("text-on-surface-variant");
    } else {
      const allBtn = filterButtons.find((b) => b.dataset.filterStyle === "all");
      if (allBtn) {
        allBtn.classList.add("border-b-2", "border-primary", "text-primary");
        allBtn.classList.remove("text-on-surface-variant");
      }
    }
  }

  function refresh() {
    applyVisibility();
    const totalVisible = cards.filter((c) => !c.hidden).length;
    const shownLimit = pageSize + extraShown;
    const reachedEnd = totalVisible <= shownLimit;
    if (endMessage) endMessage.classList.toggle("opacity-0", !reachedEnd);
    if (countEl) {
      const tpl = totalVisible === 1
        ? (countEl.dataset.countOne || "")
        : (countEl.dataset.countOther || "");
      countEl.textContent = tpl
        ? tpl.replace("{{count}}", String(totalVisible))
        : String(totalVisible);
    }
    // Re-arm the sentinel observer once layout settles (some cards might
    // have just been revealed by the filter or load-more).
    if (sentinel && "IntersectionObserver" in window) {
      sentinelObserver.disconnect();
      sentinelObserver.observe(sentinel);
    }
  }

  function applyStyle(style) {
    const known = filterButtons.some((b) => b.dataset.filterStyle === style);
    const target = known ? style : "all";
    cards.forEach((card) => {
      card.hidden = target !== "all" && (card.dataset.style || "") !== target;
    });
    extraShown = 0;
    setActiveButton(target);
    refresh();
  }

  // Infinite scroll: reveal the next page when the sentinel approaches the
  // viewport. With `loading="lazy"` on every <img>, the browser only fetches
  // the bytes the user actually scrolls toward, so 200 entries are safe.
  const sentinelObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting || loading) return;
        const totalVisible = cards.filter((c) => !c.hidden).length;
        if (totalVisible <= pageSize + extraShown) return;
        loading = true;
        extraShown += pageSize;
        refresh();
        loading = false;
      });
    },
    { rootMargin: "600px 0px" }
  );

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      applyStyle(btn.dataset.filterStyle || "all");
    });
  });

  // Preselect from ?estilo=... so the deep link from the home lands filtered.
  const initialStyle = new URLSearchParams(window.location.search).get("estilo");
  if (initialStyle) {
    applyStyle(initialStyle);
  } else {
    refresh();
  }
</script>