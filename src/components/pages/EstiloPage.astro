---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import TopBar from "../../components/TopBar.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import ScrollReveal from "../../components/ScrollReveal.astro";
import FaqHero from "../../components/FaqHero.astro";
import FaqAccordion from "../../components/FaqAccordion.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import JsonLd from "../../components/JsonLd.astro";
import { buildFaqSchema } from "../../lib/structured-data";
import { useTranslations, styleLabel, DEFAULT_LOCALE } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";
import { getEstilos } from "../../lib/estilos";
import { getTattoos } from "../../lib/tattoos";

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props as Props;
const t = useTranslations(locale);

const entry = (await getEstilos(locale)).find((e) => e.data.slug === slug);
if (!entry) {
  throw new Error(`[EstiloPage] No style page "${slug}" for locale "${locale}"`);
}
const data = entry.data;
const { Content } = await render(entry);
const label = styleLabel(t, data.style);

// Every tattoo of this style in this locale, newest first — new pieces added
// from the CMS show up here without touching the style page.
const tattoos = (await getTattoos())
  .filter((e) => e.data.locale === locale && e.data.style === data.style)
  .sort((a, b) => +b.data.date - +a.data.date);

// Cover: the image chosen in the CMS, else the newest tattoo of the style.
const cover = data.cover_image
  ? { src: data.cover_image, alt: data.cover_alt ?? "" }
  : tattoos[0]
    ? { src: tattoos[0].data.image, alt: tattoos[0].data.alt_text }
    : undefined;

const pageTitle = data.meta_title ?? `${data.title}${t("estilo_page.title_suffix")}`;
const detailHref = (s: string) => (locale === DEFAULT_LOCALE ? `/detalle/${s}/` : `/${locale}/detalle/${s}/`);
const reservaHref = locale === DEFAULT_LOCALE ? "/reserva/" : `/${locale}/reserva/`;
const faqSchema = data.faqs.length > 0 ? buildFaqSchema(data.faqs) : undefined;
---

<Layout title={pageTitle} description={data.meta_description} ogImage={cover?.src} ogType="website">
  {faqSchema && <JsonLd data={faqSchema} />}
  <TopBar />
  <main id="main" class="pt-24 scroll-mt-24">
    <FaqHero label={t("estilo_page.label")} title={data.title} subtitle={data.intro} />

    <section class="mx-auto w-full max-w-container-max px-margin-mobile pb-12 md:px-margin-desktop md:pb-section-gap">
      <div class="grid grid-cols-1 gap-gutter lg:grid-cols-12">
        <div class="estilo-body lg:col-span-7" data-reveal>
          <Content />
        </div>
        {cover && (
          <div class="lg:col-span-5" data-reveal>
            <img
              class="aspect-square w-full border border-outline-variant object-cover"
              src={cover.src}
              alt={cover.alt}
              width="800"
              height="800"
              loading="eager"
              decoding="async"
            />
          </div>
        )}
      </div>
    </section>

    {tattoos.length > 0 && (
      <section class="mx-auto w-full max-w-container-max px-margin-mobile pb-12 md:px-margin-desktop md:pb-section-gap">
        <SectionHeading title={t("estilo_page.works_title", { style: label })} />
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3" data-reveal>
          {tattoos.map((tattoo) => (
            <a
              class="group relative aspect-square touch-manipulation overflow-hidden border border-outline-variant bg-surface-container-high"
              href={detailHref(tattoo.data.slug)}
            >
              <img
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                src={tattoo.data.image}
                alt={tattoo.data.alt_text}
                loading="lazy"
                decoding="async"
                width="800"
                height="800"
                sizes="(min-width: 768px) 33vw, 100vw"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-surface to-transparent opacity-60"></div>
              <div class="absolute bottom-6 left-6">
                <span class="mb-1 block text-label-sm font-label-sm uppercase tracking-widest text-primary">{label}</span>
                <h3 class="text-headline-md font-headline-md uppercase">{tattoo.data.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {data.faqs.length > 0 && (
      <>
        <div class="mx-auto w-full max-w-container-max px-margin-mobile md:px-margin-desktop">
          <SectionHeading title={t("estilo_page.faq_title")} />
        </div>
        <FaqAccordion questions={data.faqs} />
      </>
    )}

    <CtaBanner title={t("estilo_page.cta_title")} buttonLabel={t("estilo_page.cta_button")} buttonHref={reservaHref} />
  </main>
  <Footer />
  <WhatsAppButton />
  <ScrollReveal />
</Layout>

<style>
  /* Markdown body edited from the CMS ("Texto principal"). */
  .estilo-body :global(h2) {
    margin: 2.5rem 0 1rem;
    font-family: var(--font-headline-md);
    font-size: 1.5rem;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .estilo-body :global(h2:first-child) {
    margin-top: 0;
  }
  .estilo-body :global(p),
  .estilo-body :global(ul),
  .estilo-body :global(ol) {
    margin-bottom: 1.25rem;
    color: var(--color-on-surface-variant);
    font-family: var(--font-body-lg);
    line-height: 1.75;
  }
  .estilo-body :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .estilo-body :global(ol) {
    list-style: decimal;
    padding-left: 1.25rem;
  }
  .estilo-body :global(strong) {
    color: var(--color-on-surface);
  }
  .estilo-body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>
