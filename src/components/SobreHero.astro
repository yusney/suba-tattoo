---
import { Image } from "astro:assets";
import artistPortrait from "../assets/sobre/artist-portrait.jpg";
import { useTranslations, DEFAULT_LOCALE } from "../lib/i18n";
import type { Locale } from "../lib/i18n";

interface Props {
  artistName: string;
  artistSubtitle: string;
  introText: string;
}

const { artistName, artistSubtitle, introText } = Astro.props;
const paragraphs = introText.split(/\n\n+/).map((p) => p.trim()).filter(Boolean);

const rawLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const locale: Locale = (["es", "en", "ca"] as Locale[]).includes(rawLocale) ? rawLocale : DEFAULT_LOCALE;
const t = useTranslations(locale);
---

<section class="border-b border-outline-variant">
  <div class="grid grid-cols-12 w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop min-h-[calc(100vh-96px)]">
    <div class="col-span-12 md:col-span-6 flex flex-col justify-center py-12 md:py-24 pr-0 md:pr-16">
      <span class="font-label-sm text-label-sm text-primary tracking-[0.2em] mb-4 block" data-reveal>
        {artistSubtitle}
      </span>
      <h1 class="font-display-lg text-5xl mb-6 uppercase leading-[1.05] tracking-tighter break-words text-balance [hyphens:auto] md:mb-8 md:text-7xl md:leading-[0.95] md:tracking-[-0.04em] md:break-normal" data-reveal>
        {artistName}
      </h1>
      <div class="space-y-6 text-justify text-on-surface-variant max-w-lg leading-relaxed md:text-left" data-reveal>
        {paragraphs.map((p, index) => (
          <p class={index === 0 ? "font-body-lg text-body-lg" : "font-body-md text-body-md"}>
            {p}
          </p>
        ))}
      </div>
    </div>
    <div class="col-span-12 md:col-span-6 relative h-[60vh] md:h-auto md:min-h-[calc(100vh-96px)]">
      <Image
        class="absolute inset-0 h-full w-full object-cover filter grayscale contrast-125"
        alt={t("sobre.hero_image_alt")}
        src={artistPortrait}
        widths={[768, 1024, 1376]}
        sizes="(min-width: 768px) 50vw, 100vw"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>
