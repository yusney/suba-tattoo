---
import "../styles/global.css";
import { useTranslations, getLocaleFromPath, localizePath, withTrailingSlash, LOCALES, DEFAULT_LOCALE } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
import { configuredSiteUrl, getSiteSettings } from "../lib/site";
import { buildTattooShopSchema } from "../lib/structured-data";
import { ICON_FONT_URL } from "../lib/icon-font-guard";
import { Font } from "astro:assets";
import JsonLd from "../components/JsonLd.astro";
import CookieBanner from "../components/CookieBanner.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  canonical?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = "/images/og/og-default.jpg",
  ogType = "website",
  canonical,
  noindex = false,
} = Astro.props;

const locale: Locale = (Astro.currentLocale ?? getLocaleFromPath(Astro.url.pathname)) as Locale;
const safeLocale: Locale = (LOCALES as readonly string[]).includes(locale) ? locale : DEFAULT_LOCALE;
const t = useTranslations(safeLocale);
const finalTitle = title ?? t("site_meta.default_title");
const finalDescription = description ?? t("site_meta.default_description");
const skipLabel = t("a11y.skip_to_content");

const siteOrigin = Astro.site?.origin ?? configuredSiteUrl;

// The edge (Cloudflare/nginx) answers extension-less directory paths with a
// 301 to the trailing-slash URL (e.g. /galeria -> /galeria/). Canonical,
// og:url and hreflang must point at the final 200 URL, so every emitted URL
// carries the trailing slash. The bare root stays "/".
const stripLocalePath = (() => {
  const segments = Astro.url.pathname.split("/").filter(Boolean);
  if (segments[0] === "en" || segments[0] === "ca") {
    return "/" + segments.slice(1).join("/");
  }
  return Astro.url.pathname === "/" ? "/" : Astro.url.pathname;
})();

// The canonical is self-referential per locale: the /en/ and /ca/ variants are
// distinct indexed pages with their own hreflang cluster, so they must point
// at themselves — not at the default-locale URL. Build it from the request
// pathname (locale included) so it always matches the real slug of the page.
const resolveCanonical = (value: string): string => {
  const url = new URL(value, siteOrigin ?? undefined);
  url.pathname = withTrailingSlash(url.pathname);
  return url.toString();
};
const rawCanonical =
  canonical ?? (siteOrigin ? new URL(withTrailingSlash(Astro.url.pathname), siteOrigin).toString() : undefined);
const finalCanonical = rawCanonical ? resolveCanonical(rawCanonical) : undefined;

const ogImageUrl = siteOrigin ? new URL(ogImage, siteOrigin).toString() : undefined;
const ogLocale = t("meta.og.locale_" + safeLocale) || "es_ES";
const siteName = t("meta.og.site_name");

const hreflangs = siteOrigin
  ? LOCALES.map((loc) => {
      const localizedPath = withTrailingSlash(localizePath(stripLocalePath, loc));
      return { lang: loc, href: new URL(localizedPath, siteOrigin).toString() };
    })
  : [];
const xDefaultHref = hreflangs.find((h) => h.lang === DEFAULT_LOCALE)?.href ?? (siteOrigin ? new URL("/", siteOrigin).toString() : undefined);
const robotsContent = noindex ? "noindex, nofollow" : "index, follow";

// Site-wide business entity for rich results. Settings are memoized per locale.
const settings = await getSiteSettings(safeLocale);
const tattooShopSchema = siteOrigin ? buildTattooShopSchema(settings, siteOrigin) : undefined;
---

<!doctype html>
<html class="dark" lang={safeLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Icons are served with a 1-year immutable cache (nginx.conf), so bump
         ?v= whenever the files in public/ change, or browsers keep the old one. -->
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <meta name="description" content={finalDescription} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#131313" />
    <meta name="color-scheme" content="dark" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>{finalTitle}</title>

    {finalCanonical && <link rel="canonical" href={finalCanonical} />}
    {hreflangs.map(({ lang, href }) => (
      <link rel="alternate" hreflang={lang} href={href} />
    ))}
    {xDefaultHref && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}

    {tattooShopSchema && <JsonLd data={tattooShopSchema} />}

    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDescription} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {finalCanonical && <meta property="og:url" content={finalCanonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={siteName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <!-- All fonts are served from this origin, so nothing third-party blocks
         the first paint. Text fonts come from the Astro Fonts API (configured
         in astro.config.mjs); their @font-face rules are inlined here and the
         files are not preloaded, so they don't compete with the LCP image.
         The ~4 KiB icon subset is preloaded so icons appear with the text;
         its @font-face lives here (not in global.css) because the file name
         carries a content hash taken from the manifest. `block` keeps the
         ligature words ("menu", "close") from flashing while it loads. -->
    <Font cssVariable="--font-syne" />
    <Font cssVariable="--font-plus-jakarta-sans" />
    <Font cssVariable="--font-jetbrains-mono" />
    <link rel="preload" href={ICON_FONT_URL} as="font" type="font/woff2" crossorigin />
    <style
      is:inline
      set:html={`@font-face{font-family:"Material Symbols Outlined";font-style:normal;font-weight:400;font-display:block;src:url("${ICON_FONT_URL}") format("woff2");}`}
    ></style>

    <!-- Cloudflare Turnstile anti-bot captcha. The widget is rendered
         auto-magically by this script when it finds a <div class="cf-turnstile">
         in the page (see ContactSection.astro and BookingForm.astro). The
         script is small and async, so loading it on every page is cheap. -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </head>
  <body class="bg-surface text-on-surface font-body-md">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[10000] focus:bg-primary focus:text-on-primary focus:px-4 focus:py-2 focus:font-label-sm focus:uppercase focus:tracking-widest"
    >{skipLabel}</a>
    <slot />
    <CookieBanner />
  </body>
</html>
