# Keep this value disabled until the production domain is confirmed.
PUBLIC_SITE_URL=false

# =============================================================================
# Resend — transactional email for the contact and booking forms.
# =============================================================================
# Set the three values below to enable /api/contact. If any is missing the
# sidecar still starts (so Decap keeps working), but the contact/booking
# forms will respond 503 until the full trio is configured.
#
# RESEND_API_KEY
#   API key from https://resend.com/api-keys. Use a key with the "Sending
#   access" restricted permission — never the full-access key.
RESEND_API_KEY=

# CONTACT_TO_EMAIL
#   Address that RECEIVES every form submission (the artist's inbox).
#   Can be any mailbox — staging may use a personal email, production should
#   use the studio mailbox (e.g. hola@subatattoo.es).
CONTACT_TO_EMAIL=

# CONTACT_FROM_EMAIL
#   Address that appears as the SENDER of the email. MUST be on a domain
#   verified inside Resend's dashboard, otherwise Resend rejects the send.
#   Example: "SUBA TATTOO <noreply@subatattoo.es>".
CONTACT_FROM_EMAIL=
