# Keep this value disabled until the production domain is confirmed.
PUBLIC_SITE_URL=false

# =============================================================================
# Resend — transactional email for the contact and booking forms.
# =============================================================================
# Set the three values below to enable /api/contact. If any is missing the
# sidecar still starts (so Decap keeps working), but the contact/booking
# forms will respond 503 until the full trio is configured.
#
# RESEND_API_KEY
#   API key from https://resend.com/api-keys. Use a key with the "Sending
#   access" restricted permission — never the full-access key.
RESEND_API_KEY=

# CONTACT_TO_EMAIL
#   Address that RECEIVES every form submission (the artist's inbox).
#   Can be any mailbox — staging may use a personal email, production should
#   use the studio mailbox (e.g. hola@subatattoo.es).
CONTACT_TO_EMAIL=

# CONTACT_FROM_EMAIL
#   Address that appears as the SENDER of the email. MUST be on a domain
#   verified inside Resend's dashboard, otherwise Resend rejects the send.
#   Example: "SUBA TATTOO <noreply@subatattoo.es>".
CONTACT_FROM_EMAIL=

# =============================================================================
# Cloudflare Turnstile — anti-bot captcha for contact + booking forms.
# =============================================================================
# Set BOTH keys to enable captcha verification. In production, a missing
# TURNSTILE_SECRET_KEY will reject all submissions (fail closed) with
# `503 captcha_misconfigured`. In development the check is skipped with a
# console warning so local dev works without configuring anything.
#
# Get the keys at https://dash.cloudflare.com → Turnstile → Add site.
# Use widget mode "Managed" (recommended). The free tier covers normal
# site traffic. The token expires ~5 minutes after being issued.
#
# For local dev without real Cloudflare keys, use Cloudflare's documented
# test keys (always pass) so you can exercise the success path:
#   Site key:   1x00000000000000000000AA
#   Secret:     1x00000000000000000000AA
# The "always fails" test key (forces a rejection path):
#   Site key:   2x00000000000000000000AB
#   Secret:     0x0000000000000000000000000000000000000000
#
# PUBLIC_TURNSTILE_SITE_KEY
#   Public sitekey exposed to the browser. Format: 0x4AAAAAAA...
PUBLIC_TURNSTILE_SITE_KEY=

# TURNSTILE_SECRET_KEY
#   Secret key for server-side siteverify against
#   https://challenges.cloudflare.com/turnstile/v0/siteverify.
#   NEVER expose this publicly. Format: 0x4AAAAAAA...
TURNSTILE_SECRET_KEY=
